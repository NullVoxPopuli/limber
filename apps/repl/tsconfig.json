{
  "extends": "@ember/app-tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "rootDir": "./",
    "paths": {
      "limber/tests/*": ["./tests/*"],
      "limber/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": ["vite/client", "@embroider/core/virtual", "@glint/ember-tsc/types"]
  },
  "include": ["app/**/*", "tests/**/*", "types/**/*"],
  "contentMappers": [{ "package": "ember-content-mapper", "extensions": [".gts", ".gjs"] }]
}
