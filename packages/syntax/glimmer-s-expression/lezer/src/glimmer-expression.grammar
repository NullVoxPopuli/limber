// The body of a mustache: everything between "{{" and "}}",
// or between "(" and ")" for a sub-expression.

@top Expression { "~"? body? "~"? }

body { content BlockParams? }

content { Invocation | expression | keyword }

@skip { space }

Invocation { Callee (Param | HashPair)+ }

Callee { expression | keyword }

Param { expression }

HashPair { HashKey Is expression }

BlockParams { kw<"as"> "|" BlockParam* "|" }

SubExpression { "(" content? ")" }

PathExpression { (kw<"this"> | Argument | PathHead) ("." PropertyName)* }

HashKey { identifier | keyword | kw<"this"> }

BlockParam { identifier }

PathHead { identifier }

PropertyName { identifier | keyword | kw<"this"> }

expression {
  PathExpression |
  SubExpression |
  StringLiteral |
  NumberLiteral |
  booleanLiteral |
  nullLiteral |
  undefinedLiteral
}

booleanLiteral { @specialize[@name=BooleanLiteral]<identifier, "true" | "false"> }
nullLiteral { @specialize[@name=NullLiteral]<identifier, "null"> }
undefinedLiteral { @specialize[@name=UndefinedLiteral]<identifier, "undefined"> }

keyword {
  kw<"if"> | kw<"unless"> | kw<"each"> | kw<"each-in"> | kw<"let"> | kw<"in-element"> |
  kw<"yield"> | kw<"outlet"> | kw<"debugger"> |
  kw<"on"> | kw<"fn"> | kw<"hash"> | kw<"array"> | kw<"concat"> | kw<"get"> | kw<"log"> |
  kw<"component"> | kw<"helper"> | kw<"modifier"> |
  kw<"has-block"> | kw<"has-block-params"> | kw<"unique-id"> |
  kw<"eq"> | kw<"neq"> | kw<"not-eq"> | kw<"not"> | kw<"and"> | kw<"or"> |
  kw<"gt"> | kw<"gte"> | kw<"lt"> | kw<"lte">
}

kw<term> { @specialize[@name={term}]<identifier, term> }

@tokens {
  space { $[ \t\r\n]+ }

  identifierStart { @asciiLetter | "_" | "$" | $[\u{a1}-\u{10ffff}] }
  identifierChar { identifierStart | @digit | "-" }
  identifier { identifierStart identifierChar* }

  Argument { "@" identifier }

  NumberLiteral { "-"? @digit+ ("." @digit+)? }

  StringLiteral {
    "\"" (!["\\] | "\\" _)* "\"" |
    "'" (!['\\] | "\\" _)* "'"
  }

  Is { "=" }

  "("[closedBy=")"]
  ")"[openedBy="("]
  "|" "." "~"
}

@external propSource expressionHighlighting from "./highlight"
